{
  "name": "dsh-astryx",
  "version": "0.3.0",
  "description": "Watches @astryxdesign (Astryx) releases and judges whether the newest Astryx is still compatible with this plugin's declared support contract, before an agent builds UI with it.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./compat.json": "./compat.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "src/",
    "compat.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "client.js",
    "skills/astryx/SKILL.md",
    "skills.lock.json",
    "scripts/sync-skill.mjs"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "astryx",
    "design-system",
    "compatibility"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.5 <0.3.0",
      "node": ">=22.5.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischjh/dsh-astryx.git"
  },
  "homepage": "https://github.com/chrischjh/dsh-astryx#readme",
  "bugs": {
    "url": "https://github.com/chrischjh/dsh-astryx/issues"
  },
  "author": "chrischjh"
}
